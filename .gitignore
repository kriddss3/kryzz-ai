# Gradle / Android build outputs
.gradle/
.kotlin/
build/
captures/
.cxx/

# APK files are committed ONLY under work-assets/releases/.
# Any .apk elsewhere (e.g. /release/, /dist/, root) is ignored by default.
*.apk
!work-assets/releases/*.apk

# Local SDK config (contains per-machine Android SDK paths)
local.properties

# IDE / editor
.idea/
*.iml
.vscode/
*.swp
.DS_Store
Thumbs.db

# Android Studio
.navigation/
.externalNativeBuild/
*.apk.ids
output.json

# Logs / crash dumps
*.log
*.hprof

# Signing material (NEVER commit keystores or credentials)
*.jks
*.keystore
keystore.properties

# Python (only here in case)
__pycache__/
*.pyc

# Claude Code skill outputs: /brag videos and Impeccable machine-local state
brag-output*/
.impeccable/config.local.json
.impeccable/history/
**/.impeccable/hook.cache.json
**/.impeccable/hook.pending.json
